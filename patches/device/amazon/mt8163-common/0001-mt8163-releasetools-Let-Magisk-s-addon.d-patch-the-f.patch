From 5af1ea7919ab1ae509a63db34f9045aa811c77c8 Mon Sep 17 00:00:00 2001
From: Peter Meiser <peter.meiser@gmx.com>
Date: Wed, 21 Oct 2026 08:39:30 +0200
Subject: [PATCH] mt8163: releasetools: Let Magisk's addon.d patch the final
 boot image

The generic updater restores the addon.d scripts and only then writes
boot.img. Magisk's addon.d (v1, for non-A/B updates) re-patches the boot
image from a background job that waits just five seconds, so it races
the boot write, and it keeps writing after the updater and TWRP report
success. Rebooting then can leave a half written boot image; on
Biscuit, which carries the same fix in its own releasetools, the device
looped in the preloader.

- Write boot.img in front of the addon.d restore, failing the build if
  the updater layout is not the expected one.
- After the restore, wait while any process still carries 'post-restore'
  in its command line (at most 120 s), so the install only completes
  once the boot image is final.

Change-Id: I3a9c5e1f7b2d4086c9e3a1f5b7d2c4e6a8f0b392
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 releasetools/releasetools.py | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/releasetools/releasetools.py b/releasetools/releasetools.py
index a0b6cc2..42621eb 100644
--- a/releasetools/releasetools.py
+++ b/releasetools/releasetools.py
@@ -31,3 +31,38 @@ def IncrementalOTA_Assertions(info):
 def SetupBlockDevicePaths(info):
   info.script.AppendExtra('run_program("/sbin/mkdir", "-p", "{}");'.format(BLOCK_DEVICE_DIR))
   info.script.AppendExtra('run_program("/sbin/ln", "-sf", "{}", "{}");'.format(BY_NAME_TARGET, BY_NAME_SYMLINK))
+
+# addon.d v1 scripts (Magisk) may finish post-restore in a background job;
+# wait for it (at most 120 s) so the install only completes, and the user
+# only reboots, once the boot image is final. 'post-[r]estore' matches the
+# job's command line but not its own text in grep's or this shell's.
+WAIT_FOR_ADDOND = (
+    'ui_print("Waiting for addon.d background jobs...");\n'
+    'run_program("/sbin/sh", "-c", "i=0; while [ $i -lt 120 ]; do '
+    "grep -qs 'post-[r]estore' /proc/[0-9]*/cmdline || exit 0; "
+    'sleep 1; i=$((i + 1)); done; exit 0");')
+
+def FullOTA_InstallEnd(info):
+  WriteBootBeforeAddondRestore(info)
+  return
+
+def WriteBootBeforeAddondRestore(info):
+  # The generic updater restores addon.d and then writes boot.img. Magisk's
+  # addon.d (v1, for non-A/B updates) patches the boot image from a
+  # background job that only waits five seconds, so it raced the boot write,
+  # and a reboot right after the install could leave a half written boot
+  # image. With boot.img written first, addon.d works on the final image,
+  # and the updater then waits for that job before it finishes.
+  script = info.script.script
+  restores = [i for i, line in enumerate(script)
+              if 'backuptool.sh", "restore"' in line]
+  if not restores:
+    return  # backuptool disabled: nothing to reorder
+  boots = [i for i, line in enumerate(script)
+           if line.startswith('package_extract_file("boot.img", ')]
+  if len(restores) != 1 or len(boots) != 1 or boots[0] < restores[0]:
+    raise ValueError("unexpected updater layout: addon.d restore at %s, "
+                     "boot.img write at %s" % (restores, boots))
+  boot = script.pop(boots[0])
+  script.insert(restores[0], boot)
+  script.insert(restores[0] + 2, WAIT_FOR_ADDOND)
-- 
2.53.0

