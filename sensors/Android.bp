// Ambient light sensor HAL, selected with ro.hardware.sensors=biscuit and
// wrapped by android.hardware.sensors@1.0-impl.
cc_library_shared {
    name: "sensors.biscuit",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["sensors_biscuit.c"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    header_libs: ["libhardware_headers"],
    shared_libs: ["liblog"],
}
