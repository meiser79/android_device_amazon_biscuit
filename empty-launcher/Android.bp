// Biscuit has no screen. This black HOME activity replaces the launchers,
// and its overrides keep the inherited user-facing apps out of the image.
android_app {
    name: "BiscuitEmptyLauncher",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    certificate: "platform",
    overrides: [
        // Headless: no status bar, notifications shade or keyguard to show.
        // Without SystemUI, Android 11's KeyguardServiceDelegate fails to
        // bind and treats the device as having no keyguard; the wallpaper
        // service is off (overlay). Nothing draws a web page either, and
        // WebView took about 80 MB of system; libwebviewchromium_plat_support
        // stays, since public.libraries.txt lists it.
        "SystemUI",
        "webview",

        // Launchers, settings, setup and updater. LineageParts holds
        // LineageOS's settings screens; LineageSettingsProvider stays, since
        // the lineage-sdk services in system_server read it. BiscuitService
        // answers Bluetooth pairing requests, not Settings. SimpleDeviceConfig
        // only sets the permissions hub flags for SystemUI.
        "Launcher3QuickStep",
        "LineageParts",
        "LineageSetupWizard",
        "OneTimeInitializer",
        "Settings",
        "SimpleDeviceConfig",
        "TrebuchetQuickStep",
        "Updater",

        // User apps
        "AudioFX",
        "Browser2",
        "Calendar",
        "Camera2",
        "Contacts",
        "DeskClock",
        "EasterEgg",
        "Eleven",
        "Email",
        "Etar",
        "ExactCalculator",
        "Exchange2",
        "Gallery2",
        "HTMLViewer",
        "Jelly",
        "Music",
        "MusicFX",
        "QuickSearchBox",
        "Seedvault",
        "SettingsIntelligence",
        "SoundPicker",
        "Traceur",

        // Providers and services only those apps use
        "BackupRestoreConfirmation",
        "BookmarkProvider",
        "CalendarProvider",
        "DocumentsUI",
        "DownloadProviderUi",
        "SharedStorageBackup",

        // Telephony: Biscuit has no radio, and the phone process and the
        // providers it pulls in only cost RAM.
        "BlockedNumberProvider",
        "ContactsProvider",
        "MmsService",
        "Telecom",
        "TelephonyProvider",
        "TeleService",

        // Input, wallpapers, dreams and themes
        "Backgrounds",
        "BasicDreams",
        "IconShapeSquareOverlay",
        "LatinIME",
        "LineageBlackAccent",
        "LineageBlackTheme",
        "LineageBlueAccent",
        "LineageBrownAccent",
        "LineageCyanAccent",
        "LineageGreenAccent",
        "LineageNavigationBarNoHint",
        "LineageOrangeAccent",
        "LineagePinkAccent",
        "LineagePurpleAccent",
        "LineageRedAccent",
        "LineageThemesStub",
        "LineageYellowAccent",
        "LiveWallpapersPicker",
        "NavigationBarMode2ButtonOverlay",
        "PhotoTable",
        "ThemePicker",
        "WallpaperBackup",
        "WallpaperCropper",

        // AOSP's accent, font, icon, navigation bar and display cutout
        // overlays: nothing draws what they restyle.
        "AccentColorAmethystOverlay",
        "AccentColorAquamarineOverlay",
        "AccentColorBlackOverlay",
        "AccentColorCarbonOverlay",
        "AccentColorCinnamonOverlay",
        "AccentColorGreenOverlay",
        "AccentColorOceanOverlay",
        "AccentColorOrchidOverlay",
        "AccentColorPaletteOverlay",
        "AccentColorPurpleOverlay",
        "AccentColorSandOverlay",
        "AccentColorSpaceOverlay",
        "AccentColorTangerineOverlay",
        "DisplayCutoutEmulationCornerOverlay",
        "DisplayCutoutEmulationDoubleOverlay",
        "DisplayCutoutEmulationHoleOverlay",
        "DisplayCutoutEmulationNarrowOverlay",
        "DisplayCutoutEmulationTallOverlay",
        "DisplayCutoutEmulationWaterfallOverlay",
        "DisplayCutoutEmulationWideOverlay",
        "FontNotoSerifSourceOverlay",
        "IconPackCircularAndroidOverlay",
        "IconPackCircularLauncherOverlay",
        "IconPackCircularSettingsOverlay",
        "IconPackCircularSystemUIOverlay",
        "IconPackCircularThemePickerOverlay",
        "IconPackFilledAndroidOverlay",
        "IconPackFilledLauncherOverlay",
        "IconPackFilledSettingsOverlay",
        "IconPackFilledSystemUIOverlay",
        "IconPackFilledThemePickerOverlay",
        "IconPackKaiAndroidOverlay",
        "IconPackKaiLauncherOverlay",
        "IconPackKaiSettingsOverlay",
        "IconPackKaiSystemUIOverlay",
        "IconPackKaiThemePickerOverlay",
        "IconPackRoundedAndroidOverlay",
        "IconPackRoundedLauncherOverlay",
        "IconPackRoundedSettingsOverlay",
        "IconPackRoundedSystemUIOverlay",
        "IconPackRoundedThemePickerOverlay",
        "IconPackSamAndroidOverlay",
        "IconPackSamLauncherOverlay",
        "IconPackSamSettingsOverlay",
        "IconPackSamSystemUIOverlay",
        "IconPackSamThemePickerOverlay",
        "IconPackVictorAndroidOverlay",
        "IconPackVictorLauncherOverlay",
        "IconPackVictorSettingsOverlay",
        "IconPackVictorSystemUIOverlay",
        "IconPackVictorThemePickerOverlay",
        "IconShapeHeartOverlay",
        "IconShapePebbleOverlay",
        "IconShapeRoundedRectOverlay",
        "IconShapeSquircleOverlay",
        "IconShapeTaperedRectOverlay",
        "IconShapeTeardropOverlay",
        "IconShapeVesselOverlay",
        "NavigationBarMode3ButtonOverlay",
        "NavigationBarModeGesturalOverlay",
        "NavigationBarModeGesturalOverlayExtraWideBack",
        "NavigationBarModeGesturalOverlayNarrowBack",
        "NavigationBarModeGesturalOverlayWideBack",

        // Hardware and features Biscuit does not have
        // No secure element, but SecureElement runs as a persistent app.
        "SecureElement",
        // No browser to sign in to a captive portal with
        // (InProcessNetworkStack requires the Platform variant).
        "CaptivePortalLogin",
        "PlatformCaptivePortalLogin",
        // No storage or documents UI, VPN, PAC proxies, keyboard dictionary,
        // certificate installer UI or companion device pairing.
        "CertInstaller",
        "CompanionDeviceManager",
        "ExternalStorageProvider",
        "PacProcessor",
        "ProxyHandler",
        "StorageManager",
        "UserDictionaryProvider",
        "VpnDialogs",
        "BluetoothMidiService",
        "BuiltInPrintService",
        "CtsShimPrebuilt",
        "CtsShimPrivPrebuilt",
        "DynamicSystemInstallationService",
        "ManagedProvisioning",
        "MtpService",
        "PrintRecommendationService",
        "PrintSpooler",
        "Profiles",
        "QuickAccessWallet",
        "SimAppDialog",
        // Android 11 only warns without an intent filter verifier.
        "StatementService",
        "WAPPushManager",

        // Space: system is 768 MiB, and only en_US/de_DE are built (the
        // font loader skips missing files).
        "NotoSansCJK-Regular.ttc",
        "NotoSerifCJK-Regular.ttc",

        // No display: mt8163-common's LiveDisplay HAL only registers when
        // the MediaTek display driver exists, but its VINTF fragment
        // declares it anyway, so LiveDisplayService's getService() blocks
        // the display thread until Watchdog restarts system_server.
        "vendor.lineage.livedisplay@2.0-service-mt8163",

        // No ClearKey or CAS content (manifest_biscuit.xml drops the ClearKey
        // VINTF entry) and no Perfetto tracing. Widevine stays.
        "android.hardware.cas@1.2-service",
        "android.hardware.drm@1.3-service.clearkey",
        "traced",
        "traced_probes",

        // No camera: mt8163-common builds these for its camera HAL, which
        // BoardConfig.mk leaves out; nothing else links them.
        "camera.device@1.0-impl",
        "camera.device@3.2-impl",
        "libcamsensormeta_shim",
        "libsensorndkbridge",
    ],
}
