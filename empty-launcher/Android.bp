// Biscuit has no screen. This black HOME activity replaces the launchers,
// and its overrides keep the inherited user-facing apps out of the image.
android_app {
    name: "BiscuitEmptyLauncher",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    certificate: "platform",
    overrides: [
        // Headless: no status bar, notifications shade or keyguard to show.
        // Without SystemUI, Android 11's KeyguardServiceDelegate fails to
        // bind and treats the device as having no keyguard; the wallpaper
        // service is off (overlay). Nothing draws a web page either, and
        // WebView took about 80 MB of system; libwebviewchromium_plat_support
        // stays, since public.libraries.txt lists it.
        "SystemUI",
        "webview",

        // Launchers, setup and updater
        "Launcher3QuickStep",
        "LineageSetupWizard",
        "OneTimeInitializer",
        "TrebuchetQuickStep",
        "Updater",

        // User apps
        "AudioFX",
        "Browser2",
        "Calendar",
        "Camera2",
        "Contacts",
        "DeskClock",
        "EasterEgg",
        "Eleven",
        "Email",
        "Etar",
        "ExactCalculator",
        "Exchange2",
        "Gallery2",
        "HTMLViewer",
        "Jelly",
        "Music",
        "MusicFX",
        "QuickSearchBox",
        "Seedvault",
        "SettingsIntelligence",
        "SoundPicker",
        "Traceur",

        // Providers and services only those apps use
        "BackupRestoreConfirmation",
        "BookmarkProvider",
        "CalendarProvider",
        "DocumentsUI",
        "DownloadProviderUi",
        "SharedStorageBackup",

        // Telephony: Biscuit has no radio, and the phone process and the
        // providers it pulls in only cost RAM.
        "BlockedNumberProvider",
        "ContactsProvider",
        "MmsService",
        "Telecom",
        "TelephonyProvider",
        "TeleService",

        // Input, wallpapers, dreams and themes
        "Backgrounds",
        "BasicDreams",
        "IconShapeSquareOverlay",
        "LatinIME",
        "LineageBlackAccent",
        "LineageBlackTheme",
        "LineageBlueAccent",
        "LineageBrownAccent",
        "LineageCyanAccent",
        "LineageGreenAccent",
        "LineageNavigationBarNoHint",
        "LineageOrangeAccent",
        "LineagePinkAccent",
        "LineagePurpleAccent",
        "LineageRedAccent",
        "LineageThemesStub",
        "LineageYellowAccent",
        "LiveWallpapersPicker",
        "NavigationBarMode2ButtonOverlay",
        "PhotoTable",
        "ThemePicker",
        "WallpaperBackup",
        "WallpaperCropper",

        // Hardware and features Biscuit does not have
        "BluetoothMidiService",
        "BuiltInPrintService",
        "CtsShimPrebuilt",
        "CtsShimPrivPrebuilt",
        "DynamicSystemInstallationService",
        "ManagedProvisioning",
        "MtpService",
        "PrintRecommendationService",
        "PrintSpooler",
        "Profiles",
        "QuickAccessWallet",
        "SimAppDialog",
        // Android 11 only warns without an intent filter verifier.
        "StatementService",
        "WAPPushManager",

        // Space: system is 768 MiB, and only en_US/de_DE are built (the
        // font loader skips missing files).
        "NotoSansCJK-Regular.ttc",
        "NotoSerifCJK-Regular.ttc",

        // No display: mt8163-common's LiveDisplay HAL only registers when
        // the MediaTek display driver exists, but its VINTF fragment
        // declares it anyway, so LiveDisplayService's getService() blocks
        // the display thread until Watchdog restarts system_server.
        "vendor.lineage.livedisplay@2.0-service-mt8163",
    ],
}
