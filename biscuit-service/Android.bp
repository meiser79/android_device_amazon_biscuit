// LED ring daemon (IS31FL3236 frame/boot_animation sysfs) and its client.
cc_binary {
    name: "biscuit-ledd",
    srcs: ["biscuit-ledd.cpp"],
    cflags: ["-Wall", "-Werror"],
    init_rc: ["biscuit-ledd.rc"],
}

cc_binary {
    name: "biscuit-ledctl",
    srcs: ["biscuit-ledctl.cpp"],
    cflags: ["-Wall", "-Werror"],
}

cc_binary {
    name: "i2c-poke",
    srcs: ["i2c-poke.cpp"],
    cflags: ["-Wall", "-Werror"],
}

// Buttons: follows the kernel's amz_priv state into Android and broadcasts
// the Action button.
cc_binary {
    name: "biscuit-buttond",
    srcs: ["biscuit-buttond.c"],
    cflags: ["-Wall", "-Werror"],
    init_rc: ["biscuit-buttond.rc"],
}

sh_binary {
    name: "biscuit_service",
    src: "biscuit_service",
}

android_app {
    name: "BiscuitService",
    srcs: [
        "app/src/**/*.java",
        "app/src/**/*.aidl",
    ],
    aidl: {
        local_include_dirs: ["app/src"],
    },
    manifest: "app/AndroidManifest.xml",
    certificate: "platform",
    platform_apis: true,
    optimize: {
        enabled: false,
    },
}
