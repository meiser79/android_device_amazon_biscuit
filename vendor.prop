# Audio
ro.hardware.audio.primary=biscuit

# Bluetooth
persist.bluetooth.enablenewavrcp=false

# Display (headless HWC 1.1 instead of the stock HWC 1.0 hwcomposer.mt8163.so)
ro.hardware.hwcomposer=biscuit
# The boot animation only costs memory on the 1x1 headless display
debug.sf.nobootanimation=1
# Mali stays off on Biscuit: SwiftShader GLES on AOSP's gralloc
ro.hardware.egl=swiftshader
ro.hardware.gralloc=default

# Media: Codec2 takes linear buffers from ION, not gralloc BLOB buffers,
# which gralloc.default cannot allocate (every Codec2 decoder failed to
# start). AOSP's default ION | BUFFERQUEUE, over mt8163-common's 851968
# (+ BLOB); its vendor.prop comes first in /system/build.prop.
debug.stagefright.c2-poolmask=327680

# Power: always on mains. mt8163-common's init.mt8163.power.rc then keeps
# all four cores online (MediaTek hotplug off) and sets the performance
# governor after boot.
ro.vendor.power.wall_powered=true

# Sensors (ambient light only)
ro.hardware.sensors=biscuit
