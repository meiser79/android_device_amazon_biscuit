<!--
    tablet_core_hardware.xml (mt8163-common) declares printing, so
    SystemServer starts PrintManagerService, which keeps binding the
    PrintSpooler this product leaves out ("RemotePrintSpooler:
    TimeoutException: Cannot get spooler!").
-->
<permissions>
    <unavailable-feature name="android.software.print" />
</permissions>
